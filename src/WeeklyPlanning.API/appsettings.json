{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:<your-server>.database.windows.net,1433;Initial Catalog=WeeklyPlanningDb;Authentication=Active Directory Default;Encrypt=True;"
  },
  "ExternalApi": {
    "BaseUrl": "https://chrobi-pre-prod.azurewebsites.net/api",
    "ApiKey": "<chrobi-bearer-token>",
    "TimeoutSeconds": "30"
  },
  "Jwt": {
    "Issuer": "WeeklyPlanningApp",
    "Secret": "WeeklyPlanningApp-Replace-This-32-Char-Secret"
  }
}
